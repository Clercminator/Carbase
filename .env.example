# Public values: safe for the browser. Copy these two to Vercel as well.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Existing SUPABASE_PROJECT_ID + SUPABASE_PUBLISHABLE_KEY are also supported.
# Never prefix database passwords or secret/service-role keys with VITE_.

# Mercado Pago Bricks: only PUBLIC_KEY is exposed to the browser by Vite.
MERCADOPAGO_PUBLIC_KEY=
# Server only. Keep production and test credentials in separate environments.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Required for the deployed notification handler; configured separately in Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=

# Commerce remains disabled until real report fulfillment and deployment are verified.
COMMERCE_ENABLED=false
SUBSCRIPTIONS_ENABLED=false
APP_URL=https://carbase-ten.vercel.app
# Server-only values. Use a random 32+ byte ORDER_ACCESS_SECRET independent of MP.
MERCADOPAGO_COLLECTOR_ID=
ORDER_ACCESS_SECRET=
CRON_SECRET=
# Supabase Connect > Session pooler, required if direct database DNS is unavailable.
SUPABASE_DATABASE_URL=
# Google Workspace SMTP; use an app password, not your normal Google password.
SMTP_USER=davidclerc@imrtech.xyz
SMTP_PASS=
EMAIL_FROM=Carbase <davidclerc@imrtech.xyz>
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
